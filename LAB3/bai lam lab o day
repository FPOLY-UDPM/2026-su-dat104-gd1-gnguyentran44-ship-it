  SELECT TOP 1 
    YEAR(NgayDatHang) AS [Năm],
    MONTH(NgayDatHang) AS [Tháng],
    COUNT(MaDon) AS [Số lượng đơn hàng]
FROM 
    DonDatHang
WHERE 
    NgayDatHang BETWEEN '2016-02-01' AND '2017-02-28'
GROUP BY 
    YEAR(NgayDatHang), 
    MONTH(NgayDatHang)
ORDER BY 
    [Số lượng đơn hàng] DESC;







